<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <!--
      Themed icons (Android 13+). The launcher tints a monochrome layer to match
      the user's wallpaper; without one the icon is simply left untinted while
      every other icon on the home screen follows the theme.

      The foreground drawable doubles as the monochrome source: it is already a
      flat single-colour path, which is exactly what this layer requires.
    -->
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
