// Prod. `ServerEnvironment.current` additionally refuses to honour
// `allowsInsecureTLS` when the environment is `prod`, so a mistake in this file
// cannot silently disable certificate validation in a shipped build.

SYNAPSE_ENVIRONMENT = prod
SYNAPSE_GATEWAY_URL = wss:$()//synapse.example/ws
SYNAPSE_TCP_HOST = synapse.example
SYNAPSE_TCP_PORT = 7000
SYNAPSE_TRANSPORT = webSocket
SYNAPSE_MEDIA_BASE_URL = https:$()//synapse.example
SYNAPSE_ALLOWS_INSECURE_TLS = NO

PRODUCT_BUNDLE_IDENTIFIER = chat.synapse.ios
PRODUCT_NAME = Synapse
