// Stage — a deployed gateway behind TLS. Same protocol, real certificates.

SYNCAPP_ENVIRONMENT = stage
SYNCAPP_GATEWAY_URL = wss:$()//stage.syncapp.example/ws
SYNCAPP_TCP_HOST = stage.syncapp.example
SYNCAPP_TCP_PORT = 7000
SYNCAPP_TRANSPORT = webSocket
SYNCAPP_MEDIA_BASE_URL = https:$()//stage.syncapp.example
SYNCAPP_ALLOWS_INSECURE_TLS = NO

PRODUCT_BUNDLE_IDENTIFIER = chat.syncapp.ios.stage
PRODUCT_NAME = SyncApp Stage
