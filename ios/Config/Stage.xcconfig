// Stage — a deployed gateway behind TLS. Same protocol, real certificates.

SYNAPSE_ENVIRONMENT = stage
SYNAPSE_GATEWAY_URL = wss:$()//stage.synapse.example/ws
SYNAPSE_TCP_HOST = stage.synapse.example
SYNAPSE_TCP_PORT = 7000
SYNAPSE_TRANSPORT = webSocket
SYNAPSE_MEDIA_BASE_URL = https:$()//stage.synapse.example
SYNAPSE_ALLOWS_INSECURE_TLS = NO

PRODUCT_BUNDLE_IDENTIFIER = chat.synapse.ios.stage
PRODUCT_NAME = Synapse Stage
